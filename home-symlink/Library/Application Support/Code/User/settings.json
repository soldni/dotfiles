{
    "breadcrumbs.enabled": true,
    "claudeCode.preferredLocation": "sidebar",
    "diffEditor.maxComputationTime": 0,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.fontFamily": "Iosevka Medium",
    "editor.fontLigatures": true,
    "editor.fontSize": 13,
    "editor.fontVariations": true,
    "editor.fontWeight": "normal",
    "editor.formatOnPaste": true,
    "editor.inlineSuggest.enabled": true,
    "editor.largeFileOptimizations": true,
    "editor.lineHeight": 1.3,
    "editor.minimap.autohide": "mouseover",
    "editor.minimap.enabled": false,
    "editor.multiCursorLimit": 100000,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.overviewRulerBorder": false,
    "editor.renderWhitespace": "none",
    "editor.rulers": [
        100
    ],
    "editor.selectionHighlight": false,
    "editor.snippetSuggestions": "top",
    "editor.stickyScroll.enabled": true,
    "editor.suggestSelection": "first",
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 100,
    "emmet.includeLanguages": {
        "javascript": "javascriptreact"
    },
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.fileNesting.enabled": true,
    "explorer.incrementalNaming": "smart",
    "extensions.ignoreRecommendations": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.openRepositoryInParentFolders": "always",
    "git.replaceTagsWhenPull": true,
    "latex-workshop.view.pdf.viewer": "tab",
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "notebook.output.textLineLimit": 100,
    "redhat.telemetry.enabled": false,
    "remote.SSH.remotePlatform": {
        "orb": "linux",
        "spark": "linux",
        "coder-vscode.devbox.int-dev.msi.microsoft.com--lucasoldaini-microsoft--teal-narwhal-92.main": "linux",
        "coder-vscode.devbox.int-dev.msi.microsoft.com--lucasoldaini-microsoft--emerald-orca-74.main": "linux",
        "coder-vscode.devbox.int.msi.microsoft.com--lucasoldaini-microsoft--silver-gazelle-52.main": "linux"
    },
    "remote.autoForwardPortsSource": "hybrid",
    "terminal.external.osxExec": "Ghostty.app",
    "terminal.integrated.fontFamily": "Iosevka Medium",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.inheritEnv": false,
    "terminal.integrated.lineHeight": 1.1,
    "terminal.integrated.scrollback": 100000,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.tabs.separator": " · ",
    "terminal.integrated.tabs.title": "${process}${separator}${cwd}",
    "window.closeWhenEmpty": true,
    "window.doubleClickIconToClose": true,
    "window.menuStyle": "inherit",
    "window.newWindowProfile": "Default",
    "window.openFilesInNewWindow": "on",
    "window.title": "${rootName}${separator}${activeEditorMedium}",
    "window.titleSeparator": " · ",
    "workbench.colorTheme": "Everforest Dark",
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.fontAliasing": "auto",
    "workbench.layoutControl.type": "menu",
    "workbench.sideBar.location": "left",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "workbench.tree.indent": 16,
    "terminal.integrated.hideOnStartup": "always",
    "cSpell.userWords": [
        "EUGEN",
        "Multimodal",
        "rollouts"
    ],
    "workbench.navigationControl.enabled": false,
    "window.commandCenter": false,
    "scm.repositories.selectionMode": "single",
    "workbench.activityBar.location": "top",
    "workbench.browser.showInTitleBar": false,
    "workbench.layoutControl.enabled": false,
    "latex-workshop.latex.autoBuild.run": "onSave",
    "chat.viewSessions.orientation": "stacked",
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "remote.SSH.connectTimeout": 1800,
    "remote.SSH.reconnectionGraceTime": 28800,
    "remote.SSH.maxReconnectionAttempts": null,
    "window.customTitleBarVisibility": "windowed",
    "workbench.activityBar.compact": true,
    "workbench.editor.pinnedTabSizing": "compact",
    "diffEditor.hideUnchangedRegions.enabled": true,
    "everforest.darkContrast": "medium",
    "everforest.italicKeywords": true,
    "everforest.darkWorkbench": "flat",
}
